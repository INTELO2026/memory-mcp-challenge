# Copiez ce fichier en .env et renseignez votre clé (le .env n'est jamais commité).
#
#   cp .env.example .env
#   # puis éditez .env et collez votre clé Google AI Studio

# Clé API Gemini (https://aistudio.google.com/app/apikey) — embeddings + agent de démo.
GEMINI_API_KEY=

# Backend d'embeddings : auto (défaut) | gemini | local | hashing
# auto -> Gemini si GEMINI_API_KEY présente, sinon MiniLM local, sinon hashing.
MEMBRIDGE_EMBEDDER=auto

# Modèle d'embeddings Gemini (API). gemini-embedding-001 = stable (dim 3072).
MEMBRIDGE_GEMINI_EMBED_MODEL=models/gemini-embedding-001

# Modèle local de secours (léger, ~0,5 Go RAM) utilisé si pas de clé / hors-ligne.
# Nécessite l'extra: pip install -e ".[local]"
MEMBRIDGE_LOCAL_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# LLM de l'agent de démo (Phase 2) : gemini | mock
# NB: si le tier gratuit chat est à 0 (quota), l'agent bascule auto sur le mock.
MEMBRIDGE_LLM=gemini
MEMBRIDGE_GEMINI_CHAT_MODEL=models/gemini-2.0-flash

# Cache persistant des embeddings (évite de rappeler l'API). Optionnel.
# MEMBRIDGE_CACHE=~/.cache/membridge_embeddings.db
